# OpenAI-compatible API (OpenAI, OpenRouter, Groq-with-embeddings, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Retrieval: hybrid (embeddings + BM25) with an LLM rerank pass
RERANK_MODEL=gpt-4o-mini
BASELINE_RERANK=true

# Outbound call timeout (seconds)
OPENAI_TIMEOUT=60

# Local vector store location (relative to backend/)
CHROMA_PERSIST_DIR=../chroma_db

# CORS: comma-separated origins allowed to call the API (frontend origin(s))
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Rate limiting on /api/chat (sliding window, per IP)
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW=60

# Prompt-injection guard (deny-list, hard-rejects with 400)
BASELINE_INPUT_GUARD=true

# Dev aid: stream a canned answer without an API key (verifies the SSE pipeline)
BASELINE_FAKE_STREAM=false
